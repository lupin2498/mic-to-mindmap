# Thư mục lưu dữ liệu (audio, cơ sở dữ liệu SQLite)
M2M_DATA_DIR=./data
# Ngôn ngữ mặc định của cuộc họp (vi, en, ...)
M2M_LANGUAGE=vi
# Cổng web
M2M_HOST=127.0.0.1
M2M_PORT=8000

# Ollama (LLM local) - https://ollama.com
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Whisper local (faster-whisper): tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Số lần một sửa lỗi được "học" trước khi tự động áp dụng
M2M_CORRECTION_THRESHOLD=2
